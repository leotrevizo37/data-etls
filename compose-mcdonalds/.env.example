USER_CODE_PORT=4004
DBX_BRIDGE_USER_CODE_PORT=4005
DAGSTER_WEB_PORT=3004
DAGSTER_PG_USER=dagster_user
DAGSTER_PG_PASSWORD=dagster_password
DAGSTER_PG_DB=dagster
DAGSTER_PG_PORT=5432
DAGSTER_PG_HOSTNAME=dagster-postgres

MSSQL_HOST=la-ip-o-host
MSSQL_PORT=1433
MSSQL_USER=sa
MSSQL_PASSWORD=SuperSecret
MSSQL_CONNECT_TIMEOUT=15
MSSQL_COMMAND_TIMEOUT=5000
APP_DB=-cliente-proyecto-nombre

SPARK_MASTER_UI_PORT=8080
SPARK_MASTER_PORT=7077
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_WORKER_MEM=3G
SPARK_EXECUTOR_MEM=2G
SPARK_WORKER_CORES=2

ADLS_URL=https://proddatalake.dfs.core.windows.net/datalake
ADLS_ACCOUNT_NAME=proddatalake
ADLS_CONTAINER_NAME=datalake
ADLS_BASE_PATH=datalake
ADLS_ACCOUNT_KEY=...

DIMSQL_HOST=la-ip-o-host
DIMSQL_PORT=1433
DIMSQL_USER=sa
DIMSQL_PASSWORD=SuperSecret
DIMSQL_CONNECT_TIMEOUT=15
DIMSQL_COMMAND_TIMEOUT=5000
DIM_DB=-cliente-proyecto-nombre
DIMSQL_DRIVER="com.microsoft.sqlserver.jdbc.SQLServerDriver"

BRIDGE_SYNC_CRON=0 */8 * * *
BRIDGE_DIMS_SYNC_CRON=0 11 * * 1
BRIDGE_FACTS_SYNC_CRON=0 11 * * 1-5
BRIDGE_ALL_TABLES_SYNC_CRON=
BRIDGE_ENABLE_ALL_TABLES_SCHEDULE=false
BRIDGE_CLEANUP_CRON=0 1 * * 1-5
BRIDGE_EXECUTION_TIMEZONE=America/Ciudad_Juarez
BRIDGE_WATERMARK_OVERLAP_MINUTES=15

BRIDGE_SRCSQL_HOST=la-ip-o-host
BRIDGE_SRCSQL_PORT=3306
BRIDGE_SRCSQL_USER=root
BRIDGE_SRCSQL_PASSWORD=SuperSecret
BRIDGE_SRCSQL_CONNECT_TIMEOUT=15
BRIDGE_SRCSQL_COMMAND_TIMEOUT=5000
BRIDGE_SRCSQL_FETCH_BATCH_SIZE=5000
BRIDGE_SRCSQL_DB=-cliente-proyecto-nombre
BRIDGE_SRCSQL_DRIVER=MariaDB ODBC 3.1 Driver

DBX_AUTH_MODE=pat
DATABRICKS_SERVER_HOSTNAME=dbc-xxxx.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxxxxxx
DATABRICKS_TOKEN=
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
DBX_CATALOG=main
DBX_TARGET_SCHEMA=bronze
DBX_STAGING_SCHEMA=staging
DBX_VOLUME_CATALOG=main
DBX_VOLUME_SCHEMA=files
DBX_VOLUME_NAME=bridge
DBX_STAGING_ALLOWED_LOCAL_PATH=/tmp/databricks_bridge
BRIDGE_TABLES_CONFIG_PATH=/opt/dagster/app/mcdonalds_databricks_bridge/src/mcdonalds_databricks_bridge/config/bridge_tables.json
